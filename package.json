{
    "name": "simple-web-games",
    "description": "Jogos de navegador feitos com React, TypeScript e styled-components.",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "repository": "https://github.com/BrunoSilvestre00/simple-web-games.git",
    "homepage": "https://brunosilvestre00.github.io/simple-web-games/",
    "license": "MIT",
    "packageManager": "yarn@1.22.22",
    "engines": {
        "node": "^24.22.3 || ^26.13.1"
    },
    "scripts": {
        "start": "webpack serve --mode development",
        "develop": "yarn start",
        "build": "yarn typecheck && webpack --mode production",
        "build-web": "yarn build",
        "typecheck": "tsc --noEmit",
        "test": "node --test tests/*.test.mjs",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router-dom": "7.18.5",
        "styled-components": "6.6.0"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "9.39.5",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.14.0",
        "html-webpack-plugin": "5.6.8",
        "prettier": "3.10.1",
        "ts-loader": "9.6.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0",
        "webpack": "5.112.2",
        "webpack-cli": "7.3.1",
        "webpack-dev-server": "6.1.0"
    }
}
